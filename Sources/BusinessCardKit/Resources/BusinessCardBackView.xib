<?xml version="1.0" encoding="UTF-8"?>
<document type="com.apple.InterfaceBuilder3.CocoaTouch.XIB" version="3.0" toolsVersion="22154" targetRuntime="iOS.CocoaTouch" propertyAccessControl="none" useAutolayout="YES" useTraitCollections="YES" useSafeAreas="YES" colorMatched="YES">
    <device id="retina6_12" orientation="portrait" appearance="light"/>
    <dependencies>
        <plugIn identifier="com.apple.InterfaceBuilder.IBCocoaTouchPlugin" version="22131"/>
        <capability name="Safe area layout guides" minToolsVersion="9.0"/>
        <capability name="documents saved in the Xcode 8 format" minToolsVersion="8.0"/>
    </dependencies>
    <objects>
        <placeholder placeholderIdentifier="IBFilesOwner" id="-1" userLabel="File's Owner" customClass="BusinessCardBackView" customModule="BusinessCardKit" customModuleProvider="target">
            <connections>
                <outlet property="contentView" destination="root" id="c-root"/>
                <outlet property="logoImageView" destination="logo" id="c-logo"/>
            </connections>
        </placeholder>
        <placeholder placeholderIdentifier="IBFirstResponder" id="-2" customClass="UIResponder"/>
        <view contentMode="scaleToFill" id="root">
            <rect key="frame" x="0.0" y="0.0" width="360" height="225"/>
            <autoresizingMask key="autoresizingMask" widthSizable="YES" heightSizable="YES"/>
            <subviews>
                <imageView clipsSubviews="YES" userInteractionEnabled="NO" contentMode="scaleAspectFit" horizontalHuggingPriority="251" verticalHuggingPriority="251" translatesAutoresizingMaskIntoConstraints="NO" id="logo">
                    <rect key="frame" x="90" y="92" width="180" height="40"/>
                    <constraints>
                        <constraint firstAttribute="height" constant="40" id="logo-h"/>
                    </constraints>
                </imageView>
            </subviews>
            <color key="backgroundColor" white="0.10000000000000001" alpha="1" colorSpace="custom" customColorSpace="genericGamma22GrayColorSpace"/>
            <constraints>
                <constraint firstItem="logo" firstAttribute="centerX" secondItem="root" secondAttribute="centerX" id="logo-cx"/>
                <constraint firstItem="logo" firstAttribute="centerY" secondItem="root" secondAttribute="centerY" id="logo-cy"/>
                <constraint firstItem="logo" firstAttribute="width" secondItem="root" secondAttribute="width" multiplier="0.5" id="logo-w"/>
            </constraints>
            <point key="canvasLocation" x="400" y="0.0"/>
        </view>
    </objects>
</document>
